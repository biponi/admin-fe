# API Configuration
REACT_APP_API_BASE_URL=http://localhost:7001
REACT_APP_API_URL=http://localhost:7001/api/v1

# Firebase Configuration
# Firebase config is now fetched from backend API (/api/v1/config/firebase)
# No Firebase keys needed in frontend .env - see BACKEND_FIREBASE_SETUP.md for setup instructions

# Notification Features
# Enable or disable browser notifications (native notification API)
# When set to false, only in-app notifications (toasts and notification panel) will be shown
REACT_APP_ADD_NOTIFICATION=true
