# API Configuration
VITE_API_BASE_URL=http://localhost:7001
VITE_API_URL=http://localhost:7001/api/v1

# Firebase Configuration
# Firebase config is now fetched from backend API (/api/v1/config/firebase)
# No Firebase keys needed in frontend .env - see BACKEND_FIREBASE_SETUP.md for setup instructions

# Notification Features
# Enable or disable browser notifications (native notification API)
# When set to false, only in-app notifications (toasts and notification panel) will be shown
VITE_ADD_NOTIFICATION=true

# Brand Configuration
# Centralized brand settings for the application
# These values are used across the UI, documents, and communications
VITE_BRAND_NAME="PROMX"
VITE_BRAND_SHORT_NAME="PROMX"
VITE_BRAND_COMPANY_NAME="PROMX"
VITE_BRAND_WEBSITE="https://PROMX.com"
VITE_BRAND_EMAIL="prior.retailshop.info.bd@gmail.com"
VITE_BRAND_ADDRESS="Shop 134, Genetic Plaza, Dhanmondi-27, Dhaka"
VITE_BRAND_PHONE="+880 1700-534317"

# Brand Logo URLs
# Use these to set custom logo URLs for different purposes
# All logos use the same default URL if not specified
VITE_BRAND_LOGO_URL="https://res.cloudinary.com/emerging-it/image/upload/v1755976159/2193d5ff-ffb3-4fb7-ae67-c7a79e89c3f6__1_-removebg-preview_sobjwy.png"
VITE_BRAND_INVOICE_LOGO_URL="https://res.cloudinary.com/emerging-it/image/upload/v1755976159/2193d5ff-ffb3-4fb7-ae67-c7a79e89c3f6__1_-removebg-preview_sobjwy.png"
VITE_BRAND_PACKING_LOGO_URL="https://res.cloudinary.com/emerging-it/image/upload/v1755976159/2193d5ff-ffb3-4fb7-ae67-c7a79e89c3f6__1_-removebg-preview_sobjwy.png"
VITE_BRAND_ICON_URL="https://res.cloudinary.com/emerging-it/image/upload/v1755976159/2193d5ff-ffb3-4fb7-ae67-c7a79e89c3f6__1_-removebg-preview_sobjwy.png"

# Product Listing Sort
# Default sort field for product listing pages (Create Order, etc.)
# priority | lastPurchased | createdAt | name | price | quantity
# Any other raw sortBy key accepted by the API is also allowed.
# Falls back to "priority" when unset.
VITE_DEFAULT_PRODUCT_SORT=priority

# ─── Header Weather ───────────────────────────────────────────────────────────
# Weather pill refresh interval in minutes (default 20).
# Data comes from the backend /api/v1/weather/current (WeatherAPI.com proxy).
# VITE_WEATHER_REFRESH_MINUTES=20
# Rain warning banner auto-dismiss duration in seconds (default 60)
# VITE_RAIN_WARNING_DURATION_SECONDS=60
