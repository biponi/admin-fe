# API Configuration
REACT_APP_API_BASE_URL=http://localhost:7001
REACT_APP_API_URL=http://localhost:7001/api/v1

# Firebase Configuration
# Firebase config is now fetched from backend API (/api/v1/config/firebase)
# No Firebase keys needed in frontend .env - see BACKEND_FIREBASE_SETUP.md for setup instructions

# Notification Features
# Enable or disable browser notifications (native notification API)
# When set to false, only in-app notifications (toasts and notification panel) will be shown
REACT_APP_ADD_NOTIFICATION=true

# Brand Configuration
# Centralized brand settings for the application
# These values are used across the UI, documents, and communications
REACT_APP_BRAND_NAME="Prior Admin"
REACT_APP_BRAND_SHORT_NAME="Prior"
REACT_APP_BRAND_COMPANY_NAME="PriorBD"
REACT_APP_BRAND_WEBSITE="https://priorbd.com"
REACT_APP_BRAND_EMAIL="prior.retailshop.info.bd@gmail.com"
REACT_APP_BRAND_ADDRESS="Shop 134, Genetic Plaza, Dhanmondi-27, Dhaka"
REACT_APP_BRAND_PHONE="+880 1700-534317"

# Brand Logo URLs
# Use these to set custom logo URLs for different purposes
# All logos use the same default URL if not specified
REACT_APP_BRAND_LOGO_URL="https://res.cloudinary.com/emerging-it/image/upload/v1755976159/2193d5ff-ffb3-4fb7-ae67-c7a79e89c3f6__1_-removebg-preview_sobjwy.png"
REACT_APP_BRAND_INVOICE_LOGO_URL="https://res.cloudinary.com/emerging-it/image/upload/v1755976159/2193d5ff-ffb3-4fb7-ae67-c7a79e89c3f6__1_-removebg-preview_sobjwy.png"
REACT_APP_BRAND_PACKING_LOGO_URL="https://res.cloudinary.com/emerging-it/image/upload/v1755976159/2193d5ff-ffb3-4fb7-ae67-c7a79e89c3f6__1_-removebg-preview_sobjwy.png"
REACT_APP_BRAND_ICON_URL="https://res.cloudinary.com/emerging-it/image/upload/v1755976159/2193d5ff-ffb3-4fb7-ae67-c7a79e89c3f6__1_-removebg-preview_sobjwy.png"
